# CPU optimization (i5-12600K, Alder Lake)
COMMON_FLAGS="-march=alderlake -O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
LDFLAGS="-Wl,-O1 -Wl,--as-needed"

# Compile jobs (10 threads, 8 load avg)
MAKEOPTS="-j10 -l8"

# GPU
VIDEO_CARDS="nvidia"

# USE flags (XFCE4 desktop + gaming)
USE="X udev vulkan opengl vaapi vdpau jpeg png svg gtk dbus \
     alsa pulseaudio networkmanager bluetooth"

# Language / locale
LINGUAS="en"
L10N="en"

# CPU instruction sets
CPU_FLAGS_X86="aes avx avx2 f16c fma3 mmx mmxext pclmul popcnt sse sse2 sse3 sse4_1 sse4_2 ssse3"

# Licenses
ACCEPT_LICENSE="@FREE @BINARY-REDISTRIBUTABLE"

# Build features
FEATURES="buildpkg parallel-fetch"

# Mirrors (Gentoo auto-pick nearest)
GENTOO_MIRRORS="https://distfiles.gentoo.org"

# Portage dirs
PORTDIR="/var/db/repos/gentoo"
DISTDIR="/var/cache/distfiles"
PKGDIR="/var/cache/binpkgs"
